{
  "$schema": "../../node_modules/@nebulahome/integration-sdk/schemas/profile.schema.json",
  "discovery": {
    "probe": { "op": "get", "args": { "path": "/info" } },
    "claim": [
      { "path": "vendor", "equals": "Example" },
      { "path": "id", "exists": true }
    ],
    "identity": {
      "externalId": "id",
      "name": "name",
      "model": "model",
      "swVersion": "firmware"
    }
  },
  "subscriptions": [{ "op": "poll", "args": { "path": "/state", "everyMs": 10000 } }],
  "entities": [
    {
      "domain": "light",
      "icon": "light",
      "capabilities": { "on_off": {}, "level": {} },
      "state": {
        "on_off": { "isOn": "on" },
        "level": { "level": "brightness" }
      },
      "commands": {
        "on_off.turn_on": { "op": "post", "args": { "path": "/state", "body": { "on": true } } },
        "on_off.turn_off": { "op": "post", "args": { "path": "/state", "body": { "on": false } } },
        "level.set_level": {
          "op": "post",
          "args": { "path": "/state", "body": { "brightness": { "$": "command.level" } } }
        }
      }
    }
  ]
}
