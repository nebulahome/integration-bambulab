      "icon": "printer",
      "capabilities": {
        "sensor_text": {}
      },
      "state": {
        "sensor_text": {
          "value": {
            "path": "message.print.gcode_state",
            "map": {
              "IDLE": "Idle",
              "INIT": "Starting",
              "PREPARE": "Preparing",
              "SLICING": "Slicing",
              "RUNNING": "Printing",
              "PAUSE": "Paused",
              "FINISH": "Finished",
              "FAILED": "Failed",
              "OFFLINE": "Offline"
            },
            "default": "Unknown"
          }
        }
      }
    },
