{
  "$schema": "../../node_modules/@nebulahome/integration-sdk/schemas/profile.schema.json",
  "discovery": {
    "scan": {
      "filter": "device/+/report"
    },
    "claim": [
      {
        "path": "message.print",
        "exists": true
      },
      {
        "path": "segments[1]",
        "exists": true
      }
    ],
    "identity": {
      "externalId": "segments[1]"
    }
  },
  "subscriptions": [
    {
      "op": "topic",
      "args": {
        "filter": [
          "device",
          {
            "$": "segments[1]"
          },
          "report"
        ]
      }
    },
    {
      "op": "publish",
      "args": {
        "topic": [
          "device",
          {
            "$": "segments[1]"
          },
          "request"
        ],
        "payload": {
          "pushing": {
            "sequence_id": "0",
            "command": "pushall",
            "version": 1,
            "push_target": 1
          }
        },
        "everyMs": 300000
      }
    }
  ],
  "entities": [
    {
      "domain": "light",
      "objectId": "chamber_light",
      "name": "Chamber light",
      "icon": "light",
      "capabilities": {
        "on_off": {}
      },
      "state": {
        "on_off": {
          "isOn": {
            "path": "message.print.lights_report[0].mode",
            "equals": "on"
          }
        }
      },
      "commands": {
        "on_off.turn_on": {
          "op": "publish",
          "args": {
            "topic": [
              "device",
              {
                "$": "device.segments[1]"
              },
              "request"
            ],
            "payload": {
              "system": {
                "sequence_id": "0",
                "command": "ledctrl",
                "led_node": "chamber_light",
                "led_mode": "on",
                "led_on_time": 500,
                "led_off_time": 500,
                "loop_times": 0,
                "interval_time": 0
              }
            }
          }
        },
        "on_off.turn_off": {
          "op": "publish",
          "args": {
            "topic": [
              "device",
              {
                "$": "device.segments[1]"
              },
              "request"
            ],
            "payload": {
              "system": {
                "sequence_id": "0",
                "command": "ledctrl",
                "led_node": "chamber_light",
                "led_mode": "off",
                "led_on_time": 500,
                "led_off_time": 500,
                "loop_times": 0,
                "interval_time": 0
              }
            }
          }
        }
      }
    },
    {
      "domain": "camera",
      "objectId": "chamber_camera",
      "name": "Chamber camera",
      "icon": "video",
      "capabilities": {
        "camera": {
          "hasSnapshot": true,
          "hasStream": true,
          "hasRecording": false
        }
      },
      "state": {
        "camera": {
          "isStreamAvailable": {
            "path": "message.print.ipcam.ipcam_dev",
            "map": {
              "0": false
            },
            "default": true
          }
        }
      },
      "stream": {
        "source": "bambulab/camera",
        "args": {
          "kind": "chamber-image"
        }
      }
    },
    {
      "domain": "sensor",
      "objectId": "nozzle_temperature",
      "name": "Nozzle temperature",
      "icon": "thermometer",
      "capabilities": {
        "sensor_numeric": {}
      },
      "state": {
        "sensor_numeric": {
          "value": [
            {
              "path": "message.print.device.extruder.info[0].temp",
              "bits": [0, 16]
            },
            "message.print.nozzle_temper"
          ]
        }
      },
      "unitOfMeasurement": "°C",
      "deviceClass": "temperature",
      "stateClass": "measurement",
      "displayPrecision": 1
    },
    {
      "domain": "sensor",
      "objectId": "nozzle_target_temperature",
      "name": "Nozzle target",
      "icon": "thermometer",
